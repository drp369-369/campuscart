{
  "name": "campuscart-monorepo",
  "version": "1.0.0",
  "description": "CampusCart — College-focused Student Marketplace",
  "private": true,
  "scripts": {
    "build": "npm --prefix campuscart/client run build",
    "dev:server": "npm --prefix campuscart/server run dev",
    "dev:client": "npm --prefix campuscart/client run dev",
    "seed": "npm --prefix campuscart/server run seed",
    "install:all": "npm --prefix campuscart/server install && npm --prefix campuscart/client install"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.4.1"
  },
  "keywords": ["student-marketplace", "campuscart", "college-essentials"],
  "author": "CampusCart Team",
  "license": "ISC"
}
